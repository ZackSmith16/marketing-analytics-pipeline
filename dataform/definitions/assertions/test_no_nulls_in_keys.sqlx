config {
  type: "assertion",
  description: "Keys must never be NULL. In SQL, NULL = NULL is not true, so NULL keys break joins and split rows."
}

-- Keys must never be NULL. In SQL, NULL = NULL is not true, so NULL keys
-- break joins and split rows.
SELECT *
FROM ${ref("mart_campaign_daily")}
WHERE date IS NULL
   OR platform IS NULL
   OR account_id IS NULL
   OR campaign_id IS NULL
